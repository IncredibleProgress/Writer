---
import '../styles/tailwind.css'
import { Style } from '../styles/tailwind'
import { getCollection, render } from 'astro:content'
const tw = new Style()
const articles = (await getCollection('articles')).sort(
  (a, b) => a.data.part - b.data.part)
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <title>Writer</title>
  </head>
  <body class={tw.preset.body()}>
    <main>
      <section>
        <h1 class={tw.preset.title()}>
          Les Mots & Le Sens </h1>
          
          {articles.map(async (article) => {
            const { Content } = await render(article);
            return (
              <article id={article.id} class={tw.preset.articleCard()}>
                <h2 class={tw.preset.articleTitle()}>{article.data.title}</h2>
                <div class={tw.preset.articleContent()}><Content /></div>
              </article>
            );
          })}
      </section>
    </main>
  </body>
</html>
