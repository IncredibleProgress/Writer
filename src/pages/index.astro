---
import '../styles/tailwind.css';
import { Style } from '../styles/tailwind';
import { getCollection, render } from 'astro:content';
const tw = new Style();
const articles = (await getCollection('articles'))
  .filter(article => article.data.status !== 'draft');
---
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <link rel="icon" href="/favicon.png" />
  <meta name="viewport" content="width=device-width" />
  <title>Writer</title>
</head>
<body class="flex mx-auto max-w-5xl">

  <!-- Articles -->
  <main class={tw.preset.main()}>

    <h1 class={tw.preset.title()}>
      Les Mots & Le Sens </h1>

    <ul class="flex gap-x-4 list-none justify-center mt-3 mb-10">
      <li class={tw.variant.menuItem()}> 
        <a href="#les-mots--le-sens/avant-propos">Avant-propos</a></li>
      <li class={tw.variant.menuItem()}>
        <a href="#les-mots--le-sens/i5-mental">Nouveautés</a></li>
      <li class={tw.variant.menuItem()}>
        <a href="#les-mots--le-sens/i-les-mots">Publication</a></li>
    </ul>

      {articles.map(async (article) => {
        const { Content } = await render(article);
        return (
          <article id={article.id} class={tw.preset.articleCard()}>
            <h2 class={tw.preset.articleTitle()}>{article.data.title}</h2>
            <div class={tw.preset.articleContent()}><Content /></div>
          </article>
        );
      })}
  </main>

  <!-- Sidebar -->
  <aside class="ml-4 my-10">

    <h3>Auteur</h3>
    <a href="https://www.linkedin.com/in/nicolas-champion-0a8517155/" 
      class="ml-2 text-sm space-y-2">Nicolas Champion</a>

    <h3 class="mt-4">Articles</h3>
    <nav>
      <!-- <h3>Les Mots</h3> -->
      <ul>
        {articles.map(article => (
          <li class="ml-2 text-sm space-y-2">
            <a href={`#${article.id}`}>{article.data.title}</a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>

  <!-- Vanilla JavaScript -->
  <script>
    document.addEventListener('selectionchange', () => {
      const text = window.getSelection()!.toString();
      if (text.trim().length > 0) {
        navigator.clipboard.writeText(text).catch(() => {});
      }
    });
  </script>

</body>
</html>
