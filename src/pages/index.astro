---
import '../styles/tailwind.css';

import AvantPropos from '../markdown/AvantPropos.md';
import LesMots from '../markdown/LesMots.md';

const articles = [
	{ title: 'Avant-Propos', Content: AvantPropos },
	{ title: 'Les Mots', Content: LesMots },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<title>Writer</title>
	</head>
	<body class="min-h-screen bg-[#fdf6e3] font-serif text-[#586e75]">
		<main class="mx-auto max-w-3xl px-6 py-16">
			<p class="text-sm uppercase tracking-[0.28em] text-[#b58900]">Markdown library</p>
			<h1 class="mt-3 text-5xl font-semibold leading-none tracking-tight text-[#073642] sm:text-6xl">
				Available articles
			</h1>
			<p class="mt-4 text-lg leading-8">
				Files stored in <span class="text-[#073642]">src/markdown</span>.
			</p>

			<section class="mt-10 grid gap-5">
				{articles.map(({ title, Content }) => (
					<article class="rounded-2xl border border-[#eee8d5] bg-[rgba(253,246,227,0.92)] p-6 shadow-[0_1px_3px_rgba(88,110,117,0.08)]">
						<p class="text-xs uppercase tracking-[0.22em] text-[#93a1a1]">Article</p>
						<h2 class="mt-2 text-xl font-medium leading-snug text-[#268bd2]">{title}</h2>
						<div class="mt-4 [&_h1]:mb-3 [&_h1]:text-2xl [&_h1]:font-semibold [&_h1]:leading-tight [&_h1]:text-[#073642] [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:leading-tight [&_h2]:text-[#073642] [&_h3]:mb-2 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:leading-tight [&_h3]:text-[#073642] [&_p]:mb-4 [&_p]:leading-8 [&_a]:text-[#268bd2] [&_a]:no-underline [&_strong]:text-[#073642] [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:mb-4 [&_ol]:list-decimal [&_ol]:pl-5">
							<Content />
						</div>
					</article>
				))}
			</section>
		</main>
	</body>
</html>
